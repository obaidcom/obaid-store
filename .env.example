# Public site URL (set this to the deployed Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser-safe configuration only.
# Fill these only after confirming the dedicated Obaid Store project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY or other server secrets to NEXT_PUBLIC_* variables.
# Keep any future server-only secrets in the hosting provider's environment settings.
